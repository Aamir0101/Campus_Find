# Server Configuration
NODE_ENV="development"
PORT="4000"
CORS_ORIGIN="http://localhost:3000"

# Supabase PostgreSQL Connection Strings
# DATABASE_URL: Transaction / Session Pooler URL (port 6543 with ?pgbouncer=true&connection_limit=1)
# DIRECT_URL: Direct Connection URL (port 5432, used by Prisma Migrate)
DATABASE_URL=
DIRECT_URL=

# Supabase Storage (Server-side only — never expose service-role key to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET="campusfind-item-images"
SUPABASE_EVIDENCE_BUCKET="campusfind-claim-evidence"

# Authentication & Domain Security
ALLOWED_EMAIL_DOMAINS="university.edu"
BCRYPT_ROUNDS="12"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
